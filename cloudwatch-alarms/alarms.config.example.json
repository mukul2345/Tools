  "alarms": {
    "ecs": {
      "alarmActionArn": "arn:aws:sns:eu-west-1:891377067284:GoAlerting_VerficationPlatform",
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "periodSeconds": 300,
      "anomalyThreshold": 2,
      "cpuStaticThresholdPercent": 70,
      "memoryStaticThresholdPercent": 60,
      "severityPrefix": "Critical"
    },
    "api-5xx": {
      "namePrefix": "Critical",
      "alarmActionArn": "arn:aws:sns:eu-west-1:891377067284:GoAlerting_VerficationPlatform",
      "namespace": "DFG-Observability",
      "environment": "production",
      "lookbackDays": 14,
      "defaultThresholdPercent": 5,
      "minThresholdPercent": 1,
      "maxThresholdPercent": 20,
      "minimumRequestCount": 20,
      "thresholdPercentile": 90,
      "periodSeconds": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3
    },
    "api-traffic": {
      "namePrefix": "Warning",
      "alarmActionArn": "arn:aws:sns:eu-west-1:891377067284:GoAlerting_VerficationPlatform",
      "namespace": "DFG-Observability",
      "environment": "production",
      "metricName": "API_COUNT",
      "statusCodes": [
        "200",
        "201",
        "400",
        "401",
        "403",
        "404",
        "409",
        "412",
        "500"
      ],
      "periodSeconds": 300,
      "evaluationPeriods": 3,
      "datapointsToAlarm": 3,
      "anomalyThreshold": 2
    },
    "sqs": {
      "alarmActionArn": "arn:aws:sns:eu-west-1:891377067284:GoAlerting_VerficationPlatform",
      "source": {
        "enabled": true,
        "namePrefix": "Critical",
        "periodSeconds": 300,
        "evaluationPeriods": 3,
        "datapointsToAlarm": 3,
        "ageAlarmEnabled": true,
        "visibleAlarmEnabled": true,
        "ageThresholdSeconds": 900,
        "visibleThresholdCount": 500,
        "treatMissingData": "notBreaching"
      },
      "dlq": {
        "enabled": true,
        "namePrefix": "Warning",
        "periodSeconds": 60,
        "evaluationPeriods": 1,
        "datapointsToAlarm": 1,
        "visibleAlarmEnabled": true,
        "visibleThresholdCount": 1,
        "treatMissingData": "notBreaching"
      },
      "overrides": {
        "workflow-instance-queue": {
          "ageThresholdSeconds": 600
        },
        "workflow-instance-dlq": {
          "namePrefix": "Critical",
          "visibleThresholdCount": 5
        }
      }
    }
  },
  "deleteFilters": {
    "Team": "Verification Platform",
    "AlarmType": null
  }
}