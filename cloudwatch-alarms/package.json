{
  "name": "cloudwatch-alarms",
  "version": "1.0.0",
  "description": "Config-driven CloudWatch alarms for ECS, API 5xx, API traffic, and more",
  "type": "module",
  "main": "src/cli/index.mjs",
  "bin": {
    "cloudwatch-alarms": "src/cli/index.mjs"
  },
  "scripts": {
    "start": "node src/cli/index.mjs apply",
    "apply": "node src/cli/index.mjs apply",
    "apply:dry-run": "node src/cli/index.mjs apply --dry-run",
    "delete": "node src/cli/index.mjs delete"
  },
  "keywords": ["cloudwatch", "alarms", "ecs", "api", "aws"],
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-ecs": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0"
  }
}
