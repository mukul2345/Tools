{
  "title": "Document Service API Latency",
  "region": "eu-west-1",
  "periodSeconds": 900,
  "windowMinutes": 1440,
  "baselineDays": 7,
  "minSamples": 10,
  "zThreshold": 3,
  "pctThreshold": 40,
  "timezone": "Asia/Kolkata",
  "skipWeekends": true,
