{
  "title": "Notifications Service API Count",
  "region": "eu-west-1",
  "periodSeconds": 900,
  "windowMinutes": 1440,
  "baselineDays": 7,
  "minSamples": 10,
  "zThreshold": 3,
  "pctThreshold": 40,
  "timezone": "Asia/Kolkata",
  "skipWeekends": true,
  "series": [
    {
      "name": "notifications-service [200] /notification/",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/notification/",
        "environment": "production",
        "serviceName": "notifications-service",
        "statusCode": "200"
      }
    },
    {
      "name": "notifications-service [200] /notification/email/",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/notification/email/",
        "environment": "production",
        "serviceName": "notifications-service",
        "statusCode": "200"
      }
    },
    {
      "name": "notifications-service [200] /notification/email/:id",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/notification/email/:id",
        "environment": "production",
        "serviceName": "notifications-service",
        "statusCode": "200"
      }
    },
    {
      "name": "notifications-service [200] /notification/sms/",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/notification/sms/",
        "environment": "production",
        "serviceName": "notifications-service",
        "statusCode": "200"
      }
    }
  ]
}