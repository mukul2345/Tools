        "statusCode": "200"
      }
    },
    {
      "name": "geo-spectrum-service [200] /city/:id",
      "namespace": "DFG-Observability",
      "metricName": "API_LATENCY",
      "stat": "p90",
      "dimensions": {
        "endpoint": "/city/:id",
        "environment": "production",
        "serviceName": "geo-spectrum-service",
        "statusCode": "200"
      }
    },
    {
      "name": "geo-spectrum-service [200] /country/",
      "namespace": "DFG-Observability",
      "metricName": "API_LATENCY",
      "stat": "p90",
      "dimensions": {
        "endpoint": "/country/",
        "environment": "production",
        "serviceName": "geo-spectrum-service",
        "statusCode": "200"
      }
    },
    {
      "name": "geo-spectrum-service [200] /state-province/",
      "namespace": "DFG-Observability",
      "metricName": "API_LATENCY",
      "stat": "p90",
      "dimensions": {
        "endpoint": "/state-province/",
        "environment": "production",
