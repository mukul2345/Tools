{
  "title": "Geo & Geo Spectrum Service API Latency",
  "region": "eu-west-1",
  "periodSeconds": 900,
  "windowMinutes": 1440,
  "baselineDays": 7,
  "minSamples": 10,
  "zThreshold": 3,
  "pctThreshold": 40,
  "timezone": "Asia/Kolkata",
  "skipWeekends": true,
  "series": [
    {
      "name": "geo-service [200] /address/",
      "namespace": "DFG-Observability",
      "metricName": "API_LATENCY",
      "stat": "p90",
      "dimensions": {
        "endpoint": "/address/",
        "environment": "production",
        "serviceName": "geo-service",
        "statusCode": "200"
      }
    },
    {
      "name": "geo-service [200] /address/:id",
      "namespace": "DFG-Observability",
      "metricName": "API_LATENCY",
      "stat": "p90",
      "dimensions": {
        "endpoint": "/address/:id",
        "environment": "production",
        "serviceName": "geo-service",
        "statusCode": "200"
      }
    },
    {
      "name": "geo-spectrum-service [200] /city/",
      "namespace": "DFG-Observability",
      "metricName": "API_LATENCY",
      "stat": "p90",
      "dimensions": {
        "endpoint": "/city/",
        "environment": "production",
