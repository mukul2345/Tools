{
  "title": "Geo & Geo Spectrum Service API Errors",
  "region": "eu-west-1",
  "periodSeconds": 900,
  "windowMinutes": 1440,
  "baselineDays": 7,
  "minSamples": 10,
  "zThreshold": 3,
  "pctThreshold": 40,
  "timezone": "Asia/Kolkata",
  "skipWeekends": true,
  "series": [
    {
      "name": "geo-spectrum-service [500] /city/",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/city/",
        "environment": "production",
        "serviceName": "geo-spectrum-service",
        "statusCode": "500"
      }
    },
    {
      "name": "geo-spectrum-service [500] /city/:id",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/city/:id",
        "environment": "production",
        "serviceName": "geo-spectrum-service",
        "statusCode": "500"
      }
    },
    {
      "name": "geo-spectrum-service [500] /state-province/:id",
      "namespace": "DFG-Observability",
      "metricName": "API_COUNT",
      "stat": "Sum",
      "dimensions": {
        "endpoint": "/state-province/:id",
        "environment": "production",
        "serviceName": "geo-spectrum-service",
        "statusCode": "500"
      }
    }
  ]
}