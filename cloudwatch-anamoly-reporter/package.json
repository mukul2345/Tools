{
  "name": "cloudwatch-anomaly-reporter",
  "version": "2.0.0",
  "description": "CloudWatch Anomaly Reporter with Lambda and CLI support",
  "main": "src/cli/index.mjs",
  "type": "module",
  "scripts": {
    "report": "node src/cli/index.mjs",
    "download-config": "node dashboard-to-configs.mjs",
    "server": "node src/server/index.mjs",
    "test-lambda": "node test-lambda-flow.mjs",
    "build": "cd infra && sam build --profile df-prod",
    "deploy": "cd infra && sam deploy --profile df-prod",
    "deploy:staging": "cd infra && sam deploy --profile df-prod --parameter-overrides Stage=staging",
    "deploy:prod": "cd infra && sam deploy --profile df-prod --parameter-overrides Stage=production",
    "package": "cd infra && sam package",
    "validate": "cd infra && sam validate",
    "Download_configs_VPT": "node dashboard-to-configs.mjs \"Verification_Platform_Performance\"",
    "Download_configs_Workflow": "node dashboard-to-configs.mjs \"Workflow_Performance\"",
    "Download_configs_TruProfile": "node dashboard-to-configs.mjs \"TruProfile\"",
    "Download_configs_ECS": "node dashboard-to-configs.mjs \"ECS_Observability_Dashboard\"",
    "Download_configs_Core": "node dashboard-to-configs.mjs \"Core_platform\"",
    "Download_configs_Consumer": "node dashboard-to-configs.mjs \"Consumer_Apps_Services\"",
    "Download_configs_Client": "node dashboard-to-configs.mjs \"Client_API_Integration\"",
    "Download_configs_DynamoDB": "node dashboard-to-configs.mjs \"DynamoDB_Dashboard\"",
    "Download_configs_All": "npm run Download_configs_VPT && npm run Download_configs_Workflow && npm run Download_configs_TruProfile && npm run Download_configs_ECS && npm run Download_configs_Core && npm run Download_configs_Consumer && npm run Download_configs_Client",
    "VPT_report": "npm run report -- --dashboard=Verification",
    "Workflow_report": "npm run report -- --dashboard=Workflow",
    "TruProfile_report": "npm run report -- --dashboard=TruProfile",
    "ECS_report": "npm run report -- --dashboard=ECS",
    "Core_report": "npm run report -- --dashboard=Core",
    "Consumer_report": "npm run report -- --dashboard=Consumer",
    "client_report": "npm run report -- --dashboard=Client",
    "Garuda_report": "npm run report -- --dashboard=Garuda",
    "DynamoDB_report": "npm run report -- --dashboard=DynamoDB",
    "Internal_Tools_report": "npm run report -- --dashboard=Internal"
  },
  "keywords": [
    "cloudwatch",
    "anomaly",
    "monitoring",
    "aws"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-ssm": "^3.879.0",
    "@aws-sdk/credential-providers": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "dotenv": "^17.2.3"
  }
}