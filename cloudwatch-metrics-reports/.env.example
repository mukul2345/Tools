# Confluence credentials (for auto-publish)
# Same API token as Jira works for Confluence
CONFLUENCE_USERNAME=your-email@dataflowgroup.com
CONFLUENCE_API_TOKEN=your-atlassian-api-token

# Alternative: if you have JIRA_* vars set, those work too
# JIRA_USERNAME=your-email@dataflowgroup.com
# JIRA_API_TOKEN=your-atlassian-api-token
