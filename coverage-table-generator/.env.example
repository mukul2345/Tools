# Copy to .env and adjust. run.sh sources .env if present.

# How to clone: ssh (default, uses your gitlab SSH key) or https (needs a PAT)
CLONE_PROTO=ssh

# Only needed when CLONE_PROTO=https. Read-only PAT with read_repository scope.
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# Where repos are cloned / reused. Default: ./workspace next to run.sh
# WORKDIR=./workspace

# Where CSV + MD land. Default: ./output next to run.sh
# OUTDIR=./output

# Install command run in each repo before tests. Auto-detected per repo
# (pnpm/yarn/npm) from the lockfile if left unset.
# INSTALL_CMD=

# Test-with-coverage command. Auto-detected per repo if left unset.
# Override only if a repo needs a special script, e.g. "npm run test:cov"
# COVERAGE_CMD=
