# ============================================================
# coverage-table-generator — repository list (sourced by run.sh)
# ------------------------------------------------------------
# Only SERVICE repos are listed here. Package + Internal Tool
# repos from the source table are intentionally excluded.
#
# One repo per line, pipe-separated:
#   <display-name>|<gitlab-project-path>|<team>|<default-branch>
#
# gitlab-project-path is everything after the host, i.e. what
# comes after "gitlab.com/". Clone URL is built as:
#   git@gitlab.com:<gitlab-project-path>.git         (SSH, default)
#   https://gitlab.com/<gitlab-project-path>.git     (when CLONE_PROTO=https)
#
# All paths below were verified reachable via `git ls-remote`. If one
# ever 404s, fix the path — the run.sh output tells you which failed.
# ============================================================

GITLAB_BASE_GROUP="dataflowgroup/dfg-product"

