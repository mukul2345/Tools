# workflow-mcp-server credentials template.
# Copy to `.env` and fill in:  cp .env.example .env
# `.env` is gitignored — never commit real tokens.

# Session tokens from any DFG portal (DevTools → Application → Cookies → at / rt).
# Short-lived; refresh when log/API calls start returning 401.
AT_TOKEN=
RT_TOKEN=

# Base URL of the workflow-tools-service log API.
WORKFLOW_TOOLS_URL=
