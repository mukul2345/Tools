# Auth tokens for workflow-tools-service log API (used by run-live.ts, Phase 3).
# Copy this file to `.env` (same folder) and paste your real values.
#   cp .env.example .env
#
# Where to get them: log in to any DFG portal in the browser, open DevTools →
# Application → Cookies, and copy the values of the `at` and `rt` cookies.
# These are short-lived; refresh them if Phase 3 starts returning 401/empty.
#
# `.env` is gitignored — do NOT commit real tokens.

AT_TOKEN=paste-your-at-cookie-here
RT_TOKEN=paste-your-rt-cookie-here
