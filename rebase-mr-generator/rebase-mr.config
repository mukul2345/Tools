# ============================================================
# rebase-mr configuration (sourced by rebase-mr.sh)
# ------------------------------------------------------------
# This tool does a "back-merge" (a.k.a. rebase-sync): it merges
# SOURCE_BRANCH into a throwaway sync branch cut from TARGET_BRANCH,
# pushes that sync branch, and you then raise an MR
#   <sync-branch> -> TARGET_BRANCH
# (use the sibling gitlab-mr-generator/create_mr.js for the MR).
#
# Everything here is a DEFAULT and can be overridden on the CLI.
# ============================================================

# --- Branches ---
# SOURCE_BRANCH = the branch that is ahead / whose history you want
#                 recorded into TARGET (merged FROM).
# TARGET_BRANCH = the branch you branch off and eventually target the
#                 MR at (merged INTO).
SOURCE_BRANCH="release"
TARGET_BRANCH="develop"

# --- Merge strategy ---
#   ours       -> record the merge with ZERO content changes.
#                 The sync branch tree == TARGET tree, so the MR shows
#                 0 file changes but git records SOURCE as merged
#                 (fixes "needs rebase" on TARGET -> SOURCE MRs).
#   recursive  -> a real 3-way content merge; may produce conflicts you
#                 resolve manually (script pauses/leaves it mid-merge).
MERGE_STRATEGY="ours"

# --- Sync branch name ---
# Placeholders: {source} {target} {date}(YYYYMMDD)
SYNC_BRANCH_TEMPLATE="sync/{source}-to-{target}-{date}"

# --- Push behavior ---
PUSH=1        # 1 = push the sync branch, 0 = create locally only
FORCE=0       # 1 = force-push (uses --force-with-lease) when branch exists
NO_VERIFY=1   # 1 = pass --no-verify on push (skip local pre-push hooks)

# --- Default repositories (located automatically by name) ---
# Add or remove freely. Users can also append more at runtime with
#   --add "repoA repoB"   or replace the whole set with  --only "repoX"
DEFAULT_REPOS=(
    verification-workflow-engine
    verification-request
    core-verification-data-structure-service
    verification-initiation-service
    document-generation-service
    document-management-service
    client-contract-service
    payment-service
    document-service
    poi-service
    migration-service
    alert-service
    narada
)

# --- Where to look for the repos on disk ---
# If left empty, rebase-mr.sh derives these from its own location:
#   <dataflow-repo>/VTP   and   <dataflow-repo>
# (the script lives at <dataflow-repo>/dev-toolbox/rebase-mr-generator/)
# Override only if your checkout layout differs.
SEARCH_ROOTS=()
